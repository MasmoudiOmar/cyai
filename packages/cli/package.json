{
  "name": "cyai",
  "version": "0.0.0",
  "description": "CrackYourAIInterview: practise AI-run interviews in your terminal, or serve them to Claude Code, Cursor or any MCP client.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "cyai": "./dist/bin.js"
  },
