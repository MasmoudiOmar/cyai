    ".": {
      "@cyai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cyai/core": "workspace:*",
    "@cyai/llm": "workspace:*",
    "@cyai/mcp": "workspace:*",
    "@cyai/node": "workspace:*",
    "@cyai/server": "workspace:*",
    "@cyai/spec": "workspace:*",
    "@cyai/templates": "workspace:*",
    "@cyai/web": "workspace:*"
  },
  "devDependencies": {
    "@cyai/fixtures": "workspace:*"
  }
}
