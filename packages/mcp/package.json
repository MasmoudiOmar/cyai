{
  "name": "@cyai/mcp",
  "version": "0.0.0",
  "description": "MCP server for cyai: practise AI-run interviews from Claude Code, Cursor or any MCP client. The calling agent plays the interviewer.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "cyai-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@cyai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "@cyai/source": "./src/test-support/harness.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cyai/core": "workspace:*",
    "@cyai/node": "workspace:*",
    "@cyai/spec": "workspace:*",
    "@cyai/templates": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cyai/fixtures": "workspace:*"
  }
}
