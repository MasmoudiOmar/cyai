{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo"
  },
  "exclude": [
    "${configDir}/src/**/*.test.ts",
    "${configDir}/src/test-support/**"
  ]
}
